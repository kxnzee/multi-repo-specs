#!/usr/bin/env bash
# Usage: sdd-workspace [PLAN_FILE]
# Pass PLAN_FILE for progress: isolates checkout, branch, plan path and contents.
# No argument retains the shared scratch location for review packages only.
# Without Bash: node <skill>/scripts/task-context.cjs workspace [PLAN_FILE]
set -euo pipefail
exec node "$(cd "$(dirname "$0")" && pwd)/task-context.cjs" workspace "$@"
