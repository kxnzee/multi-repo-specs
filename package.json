{
  "name": "openspec-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "openspecOrchestrator": {
    "bundledPlugins": [
      "@openspec-orch/plugin-codegraph",
      "@openspec-orch/plugin-openspec-graph"
    ]
  },
  "files": [
    "bin",
    "templates"
  ],
  "bin": {
    "openspec-orch": "./bin/openspec-orch.js"
  },
  "dependencies": {
    "@openspec-orch/core": "0.1.0",
    "@openspec-orch/plugin-change-tracking": "1.0.0",
    "@openspec-orch/plugin-codegraph": "1.0.0",
    "@openspec-orch/plugin-openspec-graph": "1.0.0"
  },
  "scripts": {
    "test": "npm run test:code",
    "test:code": "npm run test:core && npm run test:sdk && npm run test:plugins && npm run test:integration",
    "test:core": "npm test --workspace @openspec-orch/core",
    "test:sdk": "npm test --workspace @openspec-orch/plugin-sdk",
    "test:plugins": "npm test --workspace @openspec-orch/plugin-change-tracking --workspace @openspec-orch/plugin-codegraph --workspace @openspec-orch/plugin-openspec-graph",
    "test:integration": "node --test --test-concurrency=1 test/change-tracking-candidate-e2e.test.js test/distribution-plugin-cli.test.js test/workspace-skeleton.test.js",
    "check:template": "node --test --test-concurrency=1 checks/template/template.test.js",
    "check:agent-artifacts": "node --test --test-concurrency=1 checks/agent-artifacts/agent-artifacts.test.js",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 packages/core/test/*.test.js packages/plugin-sdk/test/*.test.js plugins/*/test/*.test.js test/change-tracking-candidate-e2e.test.js test/distribution-plugin-cli.test.js test/workspace-skeleton.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:code && npm run check:template && npm run check:agent-artifacts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "commander": "14.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^50.8.0",
    "execa": "9.6.0"
  }
}
