{
  "name": "openspec-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "openspecOrchestrator": {
    "defaultTemplateId": "default",
    "bundledPlugins": [
      {
        "id": "change-tracking",
        "name": "Change Tracking",
        "packageName": "@openspec-orch/plugin-change-tracking",
        "rootCommands": ["attempt"]
      },
      {
        "id": "codegraph",
        "name": "CodeGraph",
        "packageName": "@openspec-orch/plugin-codegraph"
      },
      {
        "id": "openspec-graph",
        "name": "OpenSpec Graph",
        "packageName": "@openspec-orch/plugin-openspec-graph",
        "rootCommands": ["graph"]
      }
    ]
  },
  "files": [
    "agents",
    "bin",
    "extensions",
    "templates"
  ],
  "bin": {
    "openspec-orch": "./bin/openspec-orch.js",
    "openspec-orch-codegraph": "./bin/openspec-orch-codegraph.js",
    "openspec-orch-mcp": "./bin/openspec-orch-mcp.js"
  },
  "dependencies": {
    "@openspec-orch/core": "0.1.0",
    "@openspec-orch/mcp": "1.0.0",
    "@openspec-orch/plugin-change-tracking": "1.0.0",
    "@openspec-orch/plugin-codegraph": "1.0.0",
    "@openspec-orch/plugin-openspec-graph": "1.0.0"
  },
  "scripts": {
    "test": "npm run test:code",
    "test:code": "node --test --test-concurrency=1",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:code"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "commander": "14.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^50.8.0",
    "execa": "9.6.0"
  }
}
