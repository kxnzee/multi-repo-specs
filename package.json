{
  "name": "openspec-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "openspecOrchestrator": {
    "bundledPlugins": [
      "@openspec-orch/plugin-codegraph"
    ]
  },
  "files": [
    "bin",
    "templates"
  ],
  "bin": {
    "openspec-orch": "./bin/openspec-orch.js"
  },
  "dependencies": {
    "@openspec-orch/core": "0.1.0",
    "@openspec-orch/plugin-change-tracking": "1.0.0",
    "@openspec-orch/plugin-codegraph": "1.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "commander": "14.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^50.8.0",
    "execa": "9.6.0"
  }
}
